# 环境变量配置文件
# 复制此文件为 .env 并根据实际情况修改

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ry-vue
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_PASSWORD=ruoyi123
REDIS_PORT=6379

# ==================== MinIO 配置 ====================
MINIO_ROOT_USER=ruoyi
MINIO_ROOT_PASSWORD=ruoyi123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ==================== 后端服务配置 ====================
RUOYI_SERVER_IMAGE=ruoyi/ruoyi-server:5.6.0
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev-docker

# ==================== 监控配置 ====================
MONITOR_PORT=8090

# ==================== SnailJob 配置 ====================
SNAIL_JOB_PORT=8800
SNAIL_JOB_WEB_PORT=17888
